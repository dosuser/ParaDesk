<ui:FluentWindow
    x:Class="ParaDesk.Shell.CredentialDialog"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="登录凭据"
    Width="560" Height="480"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    WindowCornerPreference="Round"
    Icon="pack://application:,,,/paradesk.ico">

    <!-- 全部用布局容器、不写死坐标：旧的 WinForms 版按 96 DPI 摆像素，
         换语言或换缩放就会把字压掉一截 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="登录凭据" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Key24"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="24,8,24,0">
            <TextBlock TextWrapping="Wrap" Opacity="0.8"
                       Text="使用账户密码（非 PIN）。Microsoft 账户填写 MicrosoftAccount\邮箱。保存后仍需由 Windows 验证登录。"/>

            <CheckBox x:Name="ChkEnable" Margin="0,18,0,0" Content="保存登录凭据"
                      Checked="OnToggle" Unchecked="OnToggle"/>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="账户"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ui:TextBox AutomationProperties.Name="账户" x:Name="TbUser" Grid.Row="0" Grid.Column="1"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="密码"
                           VerticalAlignment="Center" Margin="0,10,12,0"/>
                <ui:PasswordBox AutomationProperties.Name="密码" x:Name="TbPwd" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"/>

                <TextBlock x:Name="LblKeepPwd" Grid.Row="2" Grid.Column="1" Margin="2,6,0,0"
                           FontSize="12" Opacity="0.65" TextWrapping="Wrap" Visibility="Collapsed"
                           Text="账户不变时，密码留空可沿用；更改账户需重新输入。"/>
            </Grid>

            <ui:InfoBar Margin="0,18,0,0" IsOpen="True" Severity="Informational" IsClosable="False"
                        Title="使用 Windows 加密保存"
                        Message="仅本机当前账户可解密；同账户程序仍可访问。"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="24,20,24,20">
            <ui:Button x:Name="BtnClear" HorizontalAlignment="Left"
                       Content="清除已保存" Click="OnClear"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="取消" MinWidth="88" Margin="0,0,8,0" Click="OnCancel" IsCancel="True"/>
                <ui:Button Content="确定" MinWidth="88" Appearance="Primary" Click="OnOk" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
