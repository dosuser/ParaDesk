<ui:FluentWindow
    x:Class="ParaDesk.Shell.SetupWizard"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:ParaDesk.Shell"
    Title="欢迎使用 ParaDesk"
    Width="720" Height="640"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    WindowCornerPreference="Round"
    Icon="pack://application:,,,/paradesk.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="欢迎使用 ParaDesk" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Desktop24"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer x:Name="StepScroller" Grid.Row="1" Margin="28,4,28,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 第 1 步：介绍 -->
                <StackPanel x:Name="Step1">
                    <TextBlock TextWrapping="Wrap" Text="给你的电脑开一个分身" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.85" FontSize="14"
                               Text="在选定的显示器上打开第二个 Windows 桌面，键鼠操作与主桌面互不干扰。"/>
                    <ui:Card Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Text="共用账户和文件" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.8"
                                       Text="分身桌面使用当前 Windows 账户，共用软件和文件，不提供安全隔离。同账户程序的配置可能互相影响。"/>
                        </StackPanel>
                    </ui:Card>
                    <ui:InfoBar Margin="0,14,0,0" IsOpen="True" Severity="Informational" IsClosable="False"
                                Title="需要 Windows 专业版及以上"
                                Message="家庭版不支持。首次配置需管理员授权，日常使用无需提权。"/>
                </StackPanel>

                <!-- 第 2 步：环境检查 -->
                <!-- 环境检查与"要改什么"合成一步：配置本身已经不需要用户操作了，
                     单独留一个"点这里配置"的步骤只是多一次点击 -->
                <StackPanel x:Name="Step2" Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap" Text="环境检查" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,10,0,16" TextWrapping="Wrap" Opacity="0.85"
                               Text="检查运行条件。「启动桌面」会自动配置可修复项，需要管理员授权。"/>
                    <StackPanel x:Name="CheckList"/>
                    <ui:InfoBar x:Name="CheckBar" Margin="0,14,0,0" IsOpen="True"
                                Severity="Informational" IsClosable="False" Title="" Message=""/>
                    <ui:Button x:Name="BtnRecheck" Margin="0,10,0,0" HorizontalAlignment="Left"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Content="重新检查" Click="OnRecheck"/>
                    <ui:Card x:Name="SetupPlanCard" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Text="系统配置内容" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.8"
                                       Text="• 启用子会话、远程桌面监听器和服务自动启动&#10;• 必要时启用专用/域网络的远程桌面防火墙规则&#10;• 启用默认凭据委派，关闭「始终提示输入密码」&#10;• 关闭跨设备恢复，并抑制其在分身桌面中的错误提示"/>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>

                <StackPanel x:Name="Step3" Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap" Text="选择显示位置" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,10,0,16" TextWrapping="Wrap" Opacity="0.85"
                               Text="选择目标屏幕；点“识别屏幕”可显示编号。"/>
                    <ui:Card Padding="6">
                        <local:MonitorLayoutView x:Name="LayoutView" Height="210"
                                                 SelectionChanged="OnLayoutSelectionChanged"/>
                    </ui:Card>
                    <ui:Button Margin="0,10,0,0" HorizontalAlignment="Left"
                               Icon="{ui:SymbolIcon NumberSymbol24}"
                               Content="识别屏幕" Click="OnIdentify"/>
                </StackPanel>

                <!-- 第 4 步：完成 -->
                <StackPanel x:Name="Step4" Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap" Text="准备就绪" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,10,0,16" TextWrapping="Wrap" Opacity="0.85"
                               Text="启动前请了解以下操作和限制。"/>
                    <ui:Card Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Text="常用操作" FontWeight="SemiBold"/>
                            <TextBlock x:Name="HotkeyText" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.8"/>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card>
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Text="使用限制" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.8"
                                       Text="• 同时仅支持一个分身桌面&#10;• 剪贴板默认共享；浏览器需独立配置，可在“输入与共享”创建快捷方式&#10;• 重启前请保存分身桌面中的工作"/>
                        </StackPanel>
                    </ui:Card>

                    <TextBlock TextWrapping="Wrap" Text="启动选项" FontWeight="SemiBold" Margin="2,18,0,8"/>

                    <ui:CardControl Icon="{ui:SymbolIcon Power24}" Margin="0,0,0,8">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="登录 Windows 后自动在托盘运行" FontWeight="SemiBold"/>
                                <TextBlock Text="仅显示托盘图标，热键保持可用"
                                           Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch AutomationProperties.Name="登录 Windows 后自动在托盘运行" x:Name="SwRunAtStartup"/>
                    </ui:CardControl>

                    <ui:CardControl Icon="{ui:SymbolIcon EyeOff24}" Margin="0,0,0,8">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="默认开启仅查看" FontWeight="SemiBold"/>
                                <TextBlock Text="忽略你的键鼠输入，可用热键或托盘菜单切换"
                                           Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch AutomationProperties.Name="仅查看" x:Name="SwViewOnly"/>
                    </ui:CardControl>

                    <ui:CardControl Icon="{ui:SymbolIcon Play24}" Margin="0,0,0,8">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="完成后立即启动分身桌面" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LblStartNowHint" Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch AutomationProperties.Name="完成后立即启动分身桌面" x:Name="SwStartNow"/>
                    </ui:CardControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部导航 -->
        <Border Grid.Row="2" Padding="28,16,28,20">
            <Grid>
                <TextBlock TextWrapping="Wrap" x:Name="StepLabel" VerticalAlignment="Center" Opacity="0.6"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="BtnSkip" Content="跳过" Click="OnSkip" Margin="0,0,8,0"/>
                    <ui:Button x:Name="BtnBack" Content="上一步" Click="OnBack" Margin="0,0,8,0"/>
                    <ui:Button x:Name="BtnNext" Content="下一步" Appearance="Primary"
                               MinWidth="110" Click="OnNext"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
