<ui:FluentWindow
    x:Class="ParaDesk.Shell.MainWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:ParaDesk.Shell"
    Title="ParaDesk 分身桌面"
    Width="960" Height="720"
    MinWidth="840" MinHeight="620"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    WindowCornerPreference="Round"
    Icon="pack://application:,,,/paradesk.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="ParaDesk 分身桌面" ShowMaximize="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Desktop24"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid x:Name="SaveFailurePanel" Grid.Row="1" Margin="16,0,16,8" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="设置未保存"
                Message="当前更改仅本次有效，请重试保存。"/>
            <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Content="重试保存" Click="OnRetrySave"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 侧边导航：按"用户在想什么"分组，而不是按功能实现分组 -->
            <Border Grid.Column="0" Margin="8,0,0,8">
                <StackPanel x:Name="NavPanel" Margin="4">
                    <RadioButton x:Name="NavDesktop" Style="{StaticResource NavItemStyle}"
                        local:Nav.Icon="Desktop24"
                        Tag="Desktop" IsChecked="True" Checked="OnNavChecked" Content="桌面"/>
                    <RadioButton x:Name="NavDisplay" Style="{StaticResource NavItemStyle}"
                        local:Nav.Icon="Resize24"
                        Tag="Display" Checked="OnNavChecked" Content="画面"/>
                    <RadioButton x:Name="NavInput" Style="{StaticResource NavItemStyle}"
                        local:Nav.Icon="ArrowSwap24"
                        Tag="Input" Checked="OnNavChecked" Content="输入与共享"/>
                    <RadioButton x:Name="NavRecord" Style="{StaticResource NavItemStyle}"
                        local:Nav.Icon="Record24"
                        Tag="Record" Checked="OnNavChecked" Content="录制"/>
                    <RadioButton x:Name="NavHotkeys" Style="{StaticResource NavItemStyle}"
                        local:Nav.Icon="Keyboard24"
                        Tag="Hotkeys" Checked="OnNavChecked" Content="热键"/>
                    <Separator Margin="10,8,10,8" Opacity="0.25"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItemStyle}"
                        local:Nav.Icon="Settings24"
                        Tag="Settings" Checked="OnNavChecked" Content="设置"/>
                    <RadioButton x:Name="NavDiag" Style="{StaticResource NavItemStyle}"
                        local:Nav.Icon="Stethoscope24"
                        Tag="Diag" Checked="OnNavChecked" Content="诊断"/>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItemStyle}"
                        local:Nav.Icon="Info24"
                        Tag="About" Checked="OnNavChecked" Content="关于"/>
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="PageScroller" Grid.Column="1"
                VerticalScrollBarVisibility="Auto" Padding="20,0,20,20">
                <StackPanel>

                    <!-- ============================ 桌面 ============================ -->
                    <StackPanel x:Name="PageDesktop">

                        <!-- 状态：全局最重要的信息，永远在最上面 -->
                        <ui:Card Margin="0,0,0,14">
                            <StackPanel>
                                <!-- 三列 Grid 而不是横向 StackPanel：后者给子元素无限宽度，
                                TextWrapping 永远不生效，长句会直接被卡片右边裁掉 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="StatusIconBg" Grid.Column="0"
                                        Width="46" Height="46"
                                        CornerRadius="23" Background="#22808080"
                                        VerticalAlignment="Center">
                                        <ui:SymbolIcon x:Name="StatusIcon" Symbol="Desktop24"
                                            FontSize="24"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,12,0"
                                        VerticalAlignment="Center">
                                        <TextBlock x:Name="StatusTitle" FontSize="19"
                                            FontWeight="SemiBold" TextWrapping="Wrap"
                                            Text="未启动"/>
                                        <TextBlock x:Name="StatusDetail" Margin="0,3,0,0"
                                            TextWrapping="Wrap" Opacity="0.75"
                                            Text="正在检查环境…"/>
                                    </StackPanel>
                                    <Border x:Name="StatusBadge" Grid.Column="2"
                                        VerticalAlignment="Top" CornerRadius="11"
                                        Padding="11,3" Background="#22808080">
                                        <TextBlock TextWrapping="Wrap" x:Name="StatusBadgeText" FontSize="12"
                                            FontWeight="SemiBold" Text="未启动"/>
                                    </Border>
                                </Grid>

                                <ProgressBar x:Name="StatusProgress" Height="3" Margin="0,14,0,0"
                                    IsIndeterminate="True" Visibility="Collapsed"/>

                                <Border x:Name="MetricsPanel" Margin="0,14,0,0" Visibility="Collapsed"
                                    CornerRadius="6" Padding="0,12,0,12"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock TextWrapping="Wrap" x:Name="MetricUptime" HorizontalAlignment="Center"
                                                FontSize="17" FontWeight="SemiBold" Text="—"/>
                                            <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" FontSize="11"
                                                Opacity="0.65" Margin="0,2,0,0" Text="运行时长"/>
                                        </StackPanel>
                                        <Rectangle Grid.Column="1" Width="1" Margin="6,4,6,4"
                                            Fill="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock TextWrapping="Wrap" x:Name="MetricResolution" HorizontalAlignment="Center"
                                                FontSize="17" FontWeight="SemiBold" Text="—"/>
                                            <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" FontSize="11"
                                                Opacity="0.65" Margin="0,2,0,0" Text="分辨率"/>
                                        </StackPanel>
                                        <Rectangle Grid.Column="3" Width="1" Margin="6,4,6,4"
                                            Fill="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock TextWrapping="Wrap" x:Name="MetricMonitor" HorizontalAlignment="Center"
                                                FontSize="17" FontWeight="SemiBold" Text="—"/>
                                            <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" FontSize="11"
                                                Opacity="0.65" Margin="0,2,0,0" Text="显示位置"/>
                                        </StackPanel>
                                        <Rectangle Grid.Column="5" Width="1" Margin="6,4,6,4"
                                            Fill="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                        <StackPanel Grid.Column="6">
                                            <TextBlock TextWrapping="Wrap" x:Name="MetricSession" HorizontalAlignment="Center"
                                                FontSize="17" FontWeight="SemiBold" Text="—"/>
                                            <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" FontSize="11"
                                                Opacity="0.65" Margin="0,2,0,0" Text="会话 ID"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ui:Card>

                        <Grid x:Name="NoticePanel" Margin="0,0,0,14" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:InfoBar x:Name="NoticeBar" Grid.Column="0" IsOpen="True"
                                IsClosable="False" Severity="Informational"
                                Title="" Message=""/>
                            <ui:Button x:Name="BtnNoticeDismiss" Grid.Column="1" Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Icon="{ui:SymbolIcon CheckmarkCircle24}"
                                Content="知道了" Click="OnDismissNotice"/>
                        </Grid>

                        <!-- 主操作紧跟状态，永远不需要滚动。
                        没有独立的「首次配置」按钮：需要配置时「启动桌面」会自己弹一次授权，
                        用户只需要知道"我要开一个分身桌面"这一件事 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:Button x:Name="BtnPrimary" Grid.Column="0" HorizontalAlignment="Stretch"
                                Height="44" Appearance="Primary" Icon="{ui:SymbolIcon Play24}"
                                Content="启动桌面" Click="OnPrimary"/>
                            <ui:Button x:Name="BtnClose" Grid.Column="2" HorizontalAlignment="Stretch"
                                Height="44" Icon="{ui:SymbolIcon Dismiss24}"
                                Content="关闭桌面" Click="OnCloseDesktop"/>
                        </Grid>

                        <ui:CardControl Icon="{ui:SymbolIcon Eye24}" Margin="0,0,0,18">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Text="仅查看" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ViewOnlyQuickHint"
                                        Text="不接收你的键鼠操作；程序注入不受影响"
                                        Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch AutomationProperties.Name="仅查看" x:Name="SwViewOnlyQuick" Checked="OnViewOnly" Unchecked="OnViewOnly"/>
                        </ui:CardControl>

                        <!-- 显示位置 -->
                        <StackPanel Margin="2,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock TextWrapping="Wrap" Text="显示位置" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ui:Button Margin="10,0,0,0" Padding="10,3" FontSize="12"
                                    Icon="{ui:SymbolIcon NumberSymbol24}"
                                    Content="识别屏幕" ToolTip="在每块显示器上显示编号"
                                    Click="OnIdentify"/>
                            </StackPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <TextBlock TextWrapping="Wrap" Text="方案" VerticalAlignment="Center"
                                    Opacity="0.7" Margin="0,0,8,0"/>
                                <ComboBox HorizontalAlignment="Left" AutomationProperties.Name="方案" x:Name="CbProfile" Width="170" VerticalAlignment="Center"
                                    SelectionChanged="OnProfileSwitched"/>
                                <ui:Button AutomationProperties.Name="另存为新方案" x:Name="BtnProfileAdd" Margin="6,0,0,0" Padding="8,4"
                                    Icon="{ui:SymbolIcon Add24}" ToolTip="另存为新方案"
                                    Click="OnProfileAdd"/>
                                <ui:Button AutomationProperties.Name="重命名方案" Margin="4,0,0,0" Padding="8,4" Icon="{ui:SymbolIcon Rename24}" ToolTip="重命名方案" Click="OnProfileRename"/>
                                <ui:Button AutomationProperties.Name="删除当前方案" x:Name="BtnProfileDel" Margin="4,0,0,0" Padding="8,4"
                                    Icon="{ui:SymbolIcon Delete24}" ToolTip="删除当前方案"
                                    Click="OnProfileDelete"/>
                            </WrapPanel>
                        </StackPanel>
                        <ui:Card Padding="6">
                            <local:MonitorLayoutView x:Name="LayoutView" Height="200"
                                SelectionChanged="OnLayoutSelectionChanged"/>
                        </ui:Card>

                        <!-- 其他桌面类型：概念上与分身桌面并列，单独成节 -->
                        <TextBlock TextWrapping="Wrap" Text="其他桌面" FontWeight="SemiBold" Margin="2,22,0,8"/>
                        <ui:CardControl Icon="{ui:SymbolIcon Cube24}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Text="沙盒桌面" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SandboxHint" Opacity="0.7" FontSize="12"
                                        TextWrapping="Wrap"
                                        Text="系统同时只允许一个分身桌面；需要更多隔离桌面时可用 Windows 沙盒。"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button x:Name="BtnSandbox" Content="启动沙盒桌面" Click="OnLaunchSandbox"/>
                        </ui:CardControl>
                    </StackPanel>

                    <!-- ============================ 画面 ============================ -->
                    <StackPanel x:Name="PageDisplay" Visibility="Collapsed">
                        <TextBlock TextWrapping="Wrap" Text="画面" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,2"/>
                        <TextBlock TextWrapping="Wrap" Text="显示位置与画面质量" Opacity="0.7" Margin="0,0,0,4"/>
                        <TextBlock x:Name="DisplayScopeHint" FontSize="12" Opacity="0.62"
                            TextWrapping="Wrap" Margin="0,0,0,14"
                            Text="以下设置随方案保存。"/>

                        <!-- 目标显示器：和「桌面」页布局图是同一个设置的两个编辑器，
                        放在这里是因为下面的分辨率、缩放候选项全都由它决定 -->
                        <ui:Card Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" Text="目标显示器" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="MonitorHint" Opacity="0.7" FontSize="12"
                                            TextWrapping="Wrap"
                                            Text="分辨率和缩放选项取自此屏幕。"/>
                                    </StackPanel>
                                </StackPanel>
                                <WrapPanel>
                                    <ComboBox HorizontalAlignment="Left" AutomationProperties.Name="目标显示器" x:Name="CbMonitor" Width="250" MaxDropDownHeight="320"
                                        SelectionChanged="OnMonitorPicked"/>
                                    <ui:Button x:Name="BtnRenameMonitor" Margin="8,0,0,0"
                                        Content="重命名" Click="OnRenameMonitor"
                                        Icon="{ui:SymbolIcon Rename24}"
                                        ToolTip="给这块屏起个名字"/>
                                    <ui:Button Margin="8,0,0,0" Content="识别屏幕" Click="OnIdentify"
                                        Icon="{ui:SymbolIcon NumberSymbolSquare24}"
                                        ToolTip="在每块显示器上显示编号"/>
                                </WrapPanel>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" Text="窗口模式" FontWeight="SemiBold"/>
                                        <TextBlock Text="收起后可修改，重新接入生效"
                                            Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                                <ComboBox HorizontalAlignment="Left" AutomationProperties.Name="窗口模式" x:Name="CbWindowMode" Width="220" SelectionChanged="OnProfileChanged">
                                    <ComboBoxItem Content="全屏钉在该显示器"/>
                                    <ComboBoxItem Content="可缩放窗口"/>
                                    <ComboBoxItem Content="悬浮小窗（画中画）"/>
                                </ComboBox>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" Text="分辨率" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ResolutionHint"
                                            Text="连接时即时生效；窗口模式下可跟随窗口大小"
                                            Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                                <!-- 宽度按英文取：中文"跟随显示器（2560 × 1600）"比
                                "Match monitor (2560 × 1600)" 短，按中文取会把英文截掉 -->
                                <ComboBox HorizontalAlignment="Left" AutomationProperties.Name="分辨率" x:Name="CbResolution" Width="275" MaxDropDownHeight="320"
                                    SelectionChanged="OnProfileChanged"/>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" Text="缩放" FontWeight="SemiBold"/>
                                        <TextBlock Text="收起后可修改，重新接入生效"
                                            Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                                <ComboBox HorizontalAlignment="Left" AutomationProperties.Name="缩放" x:Name="CbScale" Width="220" SelectionChanged="OnProfileChanged">
                                    <ComboBoxItem Content="自动（跟随显示器）"/>
                                    <ComboBoxItem Content="100%"/>
                                    <ComboBoxItem Content="125%"/>
                                    <ComboBoxItem Content="150%"/>
                                    <ComboBoxItem Content="175%"/>
                                    <ComboBoxItem Content="200%"/>
                                    <ComboBoxItem Content="250%"/>
                                    <ComboBoxItem Content="300%"/>
                                </ComboBox>
                            </StackPanel>
                        </ui:Card>

                        <!-- 帧率必须和上面几张按方案的卡片拉开距离。
                        它写在 HKLM，是整机单值；和 per-profile 的下拉并排、长得一模一样，
                        位置本身就在暗示错误的作用域 -->
                        <TextBlock TextWrapping="Wrap" Text="全局设置" FontWeight="SemiBold" Margin="2,22,0,4"/>
                        <TextBlock Text="对整台电脑生效，不随方案保存。"
                            FontSize="12" Opacity="0.62" TextWrapping="Wrap" Margin="2,0,0,8"/>

                        <ui:Card Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock TextWrapping="Wrap" Text="帧率上限" FontWeight="SemiBold"/>
                                            <Border Margin="8,0,0,0" CornerRadius="8" Padding="7,1"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                                                <TextBlock TextWrapping="Wrap" Text="全系统" FontSize="11" Opacity="0.8"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="默认 30 FPS。需要管理员授权，重启电脑后生效。"
                                            Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                                <!-- 必须有独立的「应用」按钮：这是要提权的整机改动，
                                挂在 SelectionChanged 上意味着用键盘划过下拉就会连弹几次
                                UAC、连写几次注册表 -->
                                <WrapPanel>
                                    <ComboBox HorizontalAlignment="Left" AutomationProperties.Name="帧率上限" x:Name="CbFps" Width="270" MaxDropDownHeight="320"
                                        SelectionChanged="OnFpsSelectionChanged"/>
                                    <ui:Button x:Name="BtnApplyFps" Margin="8,0,0,0" Content="应用"
                                        IsEnabled="False" Click="OnApplyFps"
                                        Icon="{ui:SymbolIcon ShieldCheckmark24}"
                                        ToolTip="需要一次管理员授权"/>
                                </WrapPanel>
                            </StackPanel>
                        </ui:Card>

                    </StackPanel>

                    <!-- ======================= 输入与共享 ======================= -->
                    <StackPanel x:Name="PageInput" Visibility="Collapsed">
                        <TextBlock TextWrapping="Wrap" Text="输入与共享" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,4"/>
                        <TextBlock TextWrapping="Wrap" Text="键鼠输入与桌面共享" Opacity="0.7" Margin="0,0,0,14"/>

                        <ui:CardControl Icon="{ui:SymbolIcon Eye24}" Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Text="仅查看" FontWeight="SemiBold"/>
                                    <TextBlock Text="不接收你的键鼠操作；程序注入不受影响"
                                        Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch AutomationProperties.Name="仅查看" x:Name="SwViewOnly" Checked="OnViewOnly" Unchecked="OnViewOnly"/>
                        </ui:CardControl>

                        <ui:CardControl Icon="{ui:SymbolIcon Pin24}" Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Text="窗口置顶" FontWeight="SemiBold"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch AutomationProperties.Name="窗口置顶" x:Name="SwTopMost" Checked="OnTopMost" Unchecked="OnTopMost"/>
                        </ui:CardControl>

                        <ui:Card Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" Text="剪贴板" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ClipHint" Opacity="0.7" FontSize="12"
                                            TextWrapping="Wrap"
                                            Text="默认与主桌面共享；收起后可修改"/>
                                    </StackPanel>
                                </StackPanel>
                                <ComboBox HorizontalAlignment="Left" AutomationProperties.Name="剪贴板" x:Name="CbClipboard" Width="220" SelectionChanged="OnClipboardMode">
                                    <ComboBoxItem Content="共享（默认）"/>
                                    <ComboBoxItem Content="手动同步"/>
                                    <ComboBoxItem Content="不共享"/>
                                </ComboBox>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card x:Name="ClipManualPanel" Margin="0,0,0,8" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Icon="{ui:SymbolIcon ArrowDownload24}"
                                    Content="发送到分身桌面" Click="OnClipPush"/>
                                <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon ArrowUpload24}"
                                    Content="从分身桌面取回" Click="OnClipPull"/>
                            </StackPanel>
                        </ui:Card>

                        <ui:CardControl Icon="{ui:SymbolIcon Globe24}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Text="浏览器隔离" FontWeight="SemiBold"/>
                                    <TextBlock Text="为分身桌面创建独立的浏览器配置"
                                        Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="创建快捷方式…" Click="OnCreateBrowserShortcut"/>
                        </ui:CardControl>

                        <TextBlock TextWrapping="Wrap" Text="分身桌面里" FontWeight="SemiBold" Margin="2,22,0,4"/>
                        <TextBlock x:Name="InsideScopeHint" FontSize="12" Opacity="0.62"
                            TextWrapping="Wrap" Margin="2,0,0,8"
                            Text="以下设置随方案保存。"/>

                        <ui:Card Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" Text="登录后自动运行" FontWeight="SemiBold"/>
                                        <TextBlock Text="每次登录执行一次；已登录的桌面需关闭后再启动"
                                            Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel>
                                    <ui:TextBox AutomationProperties.Name="登录后自动运行" x:Name="TbStartupCmd" MaxLength="1000" TextWrapping="Wrap" MinHeight="64" VerticalScrollBarVisibility="Auto" AcceptsReturn="False"
                                        TextChanged="OnStartupCmdChanged"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
