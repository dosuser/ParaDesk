                        </ui:CardControl>

                        <ui:CardControl Icon="{ui:SymbolIcon Key24}" Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Text="登录凭据" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CredHint" Text="通常无需保存；登录失败时可手动设置"
                                        Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="管理…" Click="OnCredentials"/>
                        </ui:CardControl>

                        <TextBlock TextWrapping="Wrap" Text="AI 工具" FontWeight="SemiBold" Margin="2,14,0,8"/>

                        <ui:CardControl Icon="{ui:SymbolIcon PlugConnected24}" Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Text="AI 工具集成" FontWeight="SemiBold"/>
                                    <TextBlock Text="支持命令行通知（--notify）和状态查询（--status）"
                                        Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel>
                                <ui:Button HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon ClipboardPaste24}"
                                    Content="复制 Claude Code 通知配置" Click="OnCopyClaudeHooks"/>
                                <ui:Button HorizontalAlignment="Stretch" Margin="0,6,0,0"
                                    Icon="{ui:SymbolIcon ClipboardPaste24}"
                                    Content="复制命令行用法" Click="OnCopyCliUsage"/>
                            </StackPanel>
                        </ui:CardControl>

                        <ui:InfoBar x:Name="AiBar" Margin="0,0,0,8" Visibility="Collapsed"
                            IsOpen="True" IsClosable="False" Severity="Success"
                            Title="" Message=""/>
                    </StackPanel>

                    <!-- ============================ 诊断 ============================ -->
                    <StackPanel x:Name="PageDiag" Visibility="Collapsed">
                        <TextBlock TextWrapping="Wrap" Text="诊断" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,4"/>
                        <TextBlock TextWrapping="Wrap" Text="出问题时先看这里" Opacity="0.7" Margin="0,0,0,14"/>

                        <Grid Margin="2,0,0,8">
                            <TextBlock TextWrapping="Wrap" Text="环境检查" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <ui:Button x:Name="BtnDiagRecheck" HorizontalAlignment="Right"
                                Padding="10,3" FontSize="12"
                                Icon="{ui:SymbolIcon ArrowSync24}"
                                Content="重新检查" Click="OnDiagRecheck"/>
                        </Grid>
                        <ui:Card Margin="0,0,0,10">
                            <StackPanel x:Name="DiagCheckList"/>
                        </ui:Card>
                        <ui:InfoBar x:Name="DiagBar" Margin="0,0,0,18" IsOpen="True"
                            Severity="Informational" IsClosable="False" Title="" Message=""/>

                        <TextBlock TextWrapping="Wrap" Text="日志与反馈" FontWeight="SemiBold" Margin="2,0,0,8"/>
                        <ui:CardControl Icon="{ui:SymbolIcon DocumentText24}" Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Text="运行日志" FontWeight="SemiBold"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="查看日志" Click="OnViewLogs"/>
                                <ui:Button AutomationProperties.Name="打开日志文件夹" Margin="6,0,0,0" Padding="9,4"
                                    Icon="{ui:SymbolIcon FolderOpen24}"
                                    ToolTip="打开日志文件夹" Click="OnOpenLogs"/>
                            </StackPanel>
                        </ui:CardControl>

                        <ui:CardControl Icon="{ui:SymbolIcon ArrowUpload24}" Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Text="导出诊断包" FontWeight="SemiBold"/>
                                    <TextBlock Text="将日志与环境信息导出到桌面，不包含保存的凭据"
                                        Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button x:Name="BtnDiagBundle" Content="导出诊断包" Click="OnExportDiagBundle"/>
                        </ui:CardControl>

                        <ui:InfoBar x:Name="DiagActionBar" Margin="0,0,0,8" Visibility="Collapsed"
                            IsOpen="True" IsClosable="False" Severity="Informational"
                            Title="" Message=""/>

                        <TextBlock TextWrapping="Wrap" Text="系统配置" FontWeight="SemiBold" Margin="2,10,0,8"/>

                        <!-- 正常路径上用户碰不到这张卡：「启动桌面」会自己配。
                        留着是给修复用的——Windows 更新或组策略可能把设置改回去 -->
                        <ui:CardControl Icon="{ui:SymbolIcon ShieldCheckmark24}" Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Text="重新配置系统" FontWeight="SemiBold"/>
                                    <TextBlock Text="仅在系统设置被更改后需要手动修复"
                                        Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button x:Name="BtnReconfigure" Content="重新配置" Click="OnReconfigure"/>
                        </ui:CardControl>

                        <ui:CardControl Icon="{ui:SymbolIcon Delete24}" Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Text="撤销系统配置" FontWeight="SemiBold"/>
                                    <TextBlock Text="撤销 ParaDesk 修改的系统设置"
                                        Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button x:Name="BtnUndoSetup" Content="撤销配置…" Click="OnUndoSetup"/>
                        </ui:CardControl>

                        <ui:CardControl Icon="{ui:SymbolIcon BookQuestionMark24}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Text="使用引导" FontWeight="SemiBold"/>
                                    <TextBlock TextWrapping="Wrap" Text="查看首次使用引导" Opacity="0.7" FontSize="12"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="重新查看引导" Click="OnShowWizard"/>
                        </ui:CardControl>
                    </StackPanel>

                    <!-- ============================ 关于 ============================ -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                        <TextBlock TextWrapping="Wrap" Text="关于" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,14"/>
                        <ui:Card>
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" x:Name="AboutTitle" FontSize="17" FontWeight="SemiBold"
                                    Text="ParaDesk 分身桌面"/>
                                <TextBlock TextWrapping="Wrap" x:Name="AboutVersion" Opacity="0.75" Margin="0,4,0,12"/>
                                <TextBlock TextWrapping="Wrap" Opacity="0.85"
                                    Text="第二个 Windows 桌面，键鼠独立，共用当前账户和文件，不提供安全隔离。"/>
                                <TextBlock TextWrapping="Wrap" Text="程序位置" Margin="0,14,0,4" FontWeight="SemiBold"/>
                                <TextBox AutomationProperties.Name="程序位置" x:Name="AboutExePath" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"/>
                                <TextBlock TextWrapping="Wrap" Text="数据目录" Margin="0,10,0,4" FontWeight="SemiBold"/>
                                <TextBox AutomationProperties.Name="数据目录" x:Name="AboutDataPath" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <ui:Button Content="复制诊断摘要" Click="OnCopyDiagnostics"/>
                                    <ui:Button Margin="8,0,0,0" Content="打开数据目录" Click="OnOpenDataDirectory"/>
                                </WrapPanel>
                                <TextBlock x:Name="AboutEnv" Margin="0,14,0,0" Opacity="0.7" FontSize="12"
                                    TextWrapping="Wrap"/>
                            </StackPanel>
                        </ui:Card>

                        <ui:CardControl Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,12,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Text="检查更新" FontWeight="SemiBold"/>
                                    <TextBlock Text="访问 GitHub 查询是否有新版本"
                                        Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button x:Name="BtnOpenDownload" Margin="0,0,8,0" Visibility="Collapsed"
                                    Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}"
                                    Content="打开下载页" Click="OnOpenDownload"/>
                                <ui:Button x:Name="BtnCheckUpdate" Content="检查更新" Click="OnCheckUpdate"/>
                            </StackPanel>
                        </ui:CardControl>

                        <ui:InfoBar x:Name="UpdateBar" Visibility="Collapsed"
                            IsOpen="True" IsClosable="False" Severity="Informational"
                            Title="" Message=""/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>
